# --- Mock Instagram API ---
MOCK_API_BASE_URL=https://pseudogram-api.onrender.com
# Your API key for the mock API. Also used as the HMAC secret to verify
# incoming webhook signatures (see app/services/signature.py).
MOCK_API_KEY=

# --- Database ---
# Local dev example: postgresql+psycopg2://linkplease:linkplease@localhost:5432/linkplease
DATABASE_URL=

# --- Redis ---
# NOT currently used. Background jobs are stored and processed straight out of
# PostgreSQL (see README "Why not Redis/Celery" section) so that job state and
# dedup/rate-limit state all live in one durable place. Kept here because the
# assignment spec lists it, and in case you want to swap to a Redis-backed
# queue later.
REDIS_URL=

# --- Rate limiting ---
# Max DM send requests allowed per rolling window, per the mock API's limits.
DM_RATE_LIMIT_MAX=10
DM_RATE_LIMIT_WINDOW_SECONDS=60

# --- Retry policy ---
DM_MAX_ATTEMPTS=6
DM_RETRY_BASE_SECONDS=5
DM_RETRY_MAX_SECONDS=300

# --- Worker loop tuning ---
WORKER_POLL_INTERVAL_SECONDS=1
RECONCILE_POLL_INTERVAL_SECONDS=5
